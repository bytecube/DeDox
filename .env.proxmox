# DeDox - Proxmox Deployment Environment
# Copy this to .env and customize for your setup:
#   cp .env.proxmox .env
#
# Then generate secrets:
#   sed -i "s|DEDOX_JWT_SECRET=.*|DEDOX_JWT_SECRET=$(openssl rand -base64 32)|" .env
#   sed -i "s|PAPERLESS_SECRET_KEY=.*|PAPERLESS_SECRET_KEY=$(openssl rand -base64 32)|" .env
#   sed -i "s|OPENWEBUI_SECRET_KEY=.*|OPENWEBUI_SECRET_KEY=$(openssl rand -base64 32)|" .env
#   sed -i "s|POSTGRES_PASSWORD=.*|POSTGRES_PASSWORD=$(openssl rand -base64 32)|" .env

# =============================================================================
# SECURITY - CHANGE THESE!
# =============================================================================
DEDOX_JWT_SECRET=GENERATE-ME
DEDOX_ADMIN_EMAIL=admin@example.com
DEDOX_ADMIN_PASSWORD=changeme123

# =============================================================================
# EXTERNAL OLLAMA (already running on your Proxmox host/LXC)
# =============================================================================
DEDOX_OLLAMA_URL=http://192.168.1.38:11434
# Model name - make sure it's already pulled in your Ollama instance
OLLAMA_MODEL=qwen3-vl:8b

# =============================================================================
# PAPERLESS-NGX (bundled in this stack)
# =============================================================================
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=changeme123
PAPERLESS_SECRET_KEY=GENERATE-ME
POSTGRES_PASSWORD=GENERATE-ME

# Leave empty to auto-generate token from admin credentials above
DEDOX_PAPERLESS_TOKEN=

# =============================================================================
# OPEN WEBUI (bundled, connects to your external Ollama)
# =============================================================================
OPENWEBUI_SECRET_KEY=GENERATE-ME
OPENWEBUI_ADMIN_EMAIL=admin@example.com
OPENWEBUI_ADMIN_PASSWORD=changeme123
OPENWEBUI_PORT=3000

# Leave empty for auto-generation
DEDOX_OPENWEBUI_API_KEY=

# =============================================================================
# OPTIONAL
# =============================================================================
# DEDOX_WEBHOOK_SECRET=
# OLLAMA_CONTEXT_WINDOW=16384
# OLLAMA_OCR_TEXT_LIMIT=8000
