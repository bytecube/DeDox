# DeDox + Paperless-ngx - Proxmox Deployment
# Copy to .env and fill in your values

# =============================================================================
# SECURITY - CHANGE THESE!
# =============================================================================

# Generate with: openssl rand -base64 32
DEDOX_JWT_SECRET=CHANGE-ME
PAPERLESS_SECRET_KEY=CHANGE-ME

# DeDox admin credentials (auto-created on first startup)
DEDOX_ADMIN_EMAIL=admin@example.com
DEDOX_ADMIN_PASSWORD=changeme123

# =============================================================================
# LLM - llama.cpp connection
# =============================================================================

# Your llama.cpp server URL (OpenAI-compatible API)
DEDOX_OLLAMA_URL=http://192.168.1.50:8080

# API key (leave empty if llama.cpp has no auth)
DEDOX_LLM_API_KEY=

# Model name as reported by llama.cpp (check with: curl http://192.168.1.50:8080/v1/models)
OLLAMA_MODEL=

# =============================================================================
# PAPERLESS-NGX
# =============================================================================

# Paperless admin credentials
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=admin

# PostgreSQL password
POSTGRES_PASSWORD=paperless

# External URL for Paperless (how you access it in browser)
PAPERLESS_URL=http://REPLACE-WITH-THIS-LXC-IP:8080

# =============================================================================
# OPEN WEBUI - External instance on 192.168.1.50
# =============================================================================

# Leave API key empty for auto-generation using admin credentials
DEDOX_OPENWEBUI_API_KEY=

# Open WebUI admin credentials (for auto API key generation)
OPENWEBUI_ADMIN_EMAIL=admin@example.com
OPENWEBUI_ADMIN_PASSWORD=
